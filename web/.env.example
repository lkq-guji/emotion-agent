# 服务端变量；不要增加 VITE_ 前缀，也不要提交真实密钥。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=120
# 后台任务库（本机私人文件，禁止提交）；默认使用此路径。
XINYU_AGENT_DB=.runtime/xinyu-agent.sqlite3
# 也支持 XINYU_API_KEY、XINYU_MODEL、XINYU_BASE_URL 配置 OpenAI 兼容服务。
# 可选，仅使用本地 BGE 中文 ONNX q8 模型目录；留空使用 FTS5。
XINYU_EMBEDDING_DIR=
